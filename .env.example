# Copy to .env for local builds. Vercel: set the same names in Project > Settings > Environment Variables.
# PUBLIC values (shipped to the browser; safe only because RLS protects the data):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Optional until your custom domain is confirmed (e.g. https://yourdomain.pk, no trailing slash).
# If empty, Vercel's automatic production URL is used.
SITE_URL=
# NEVER put a service_role / sb_secret_ key anywhere in this project (the build refuses it).
